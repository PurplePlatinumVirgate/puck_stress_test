{
  "name": "Chat-heavy (mod stress demo)",
  "description": "Demonstrates scripted_actions: bots periodically send chat, slash commands, and quick-chats while baseline behaviors continue. Use this shape as a template when profiling a mod whose hot path is chat / command processing.",
  "schema_version": 1,
  "duration_seconds": 180,
  "seed": 7,
  "bot_count": 12,
  "team_assignment": "alternate",
  "position_distribution": { "skater": 11, "goalie": 1 },
  "behavior": {
    "skate_to_puck": true,
    "rotate_stick_to_puck": true,
    "rotate_head_to_puck": true,
    "attempt_poke": true,
    "push_to_opposing_goal": true,
    "respect_faceoff": true,
    "pass_to_teammate": false,
    "line_change": false
  },
  "scripted_actions": [
    { "at_seconds":  10, "bot_indices": "all",
      "action": "chat", "args": { "text": "gl hf" } },

    { "at_seconds":  30, "bot_indices": [0, 3, 6, 9],
      "action": "quick_chat", "args": { "id": 1 } },

    { "at_seconds":  45, "bot_indices": [1],
      "action": "command", "args": { "command": "/stats" } },

    { "at_seconds":  60, "bot_indices": "all",
      "action": "quick_chat", "args": { "id": 5 } },

    { "at_seconds":  90, "bot_indices": [2, 5, 8, 11],
      "action": "chat", "args": { "text": "nice play" } },

    { "at_seconds": 120, "bot_indices": [4],
      "action": "command", "args": { "command": "/save" } },

    { "at_seconds": 150, "bot_indices": "all",
      "action": "chat", "args": { "text": "gg" } }
  ],
  "mod_specific": {
    "example_mod": {
      "comment": "Mod-specific behavior plugins read this dict by mod ID. Fields are author-defined; harness does not validate.",
      "trigger_save_event_every_seconds": 30
    }
  }
}
